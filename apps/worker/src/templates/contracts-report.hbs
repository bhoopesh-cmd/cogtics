<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Contracts Report</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      line-height: 1.6;
      color: #1a1a1a;
      background: #fff;
      padding: 40px;
    }
    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      border-bottom: 3px solid #ff6500;
      padding-bottom: 20px;
      margin-bottom: 30px;
    }
    .logo {
      font-size: 28px;
      font-weight: 700;
      color: #ff6500;
    }
    .meta {
      text-align: right;
      font-size: 12px;
      color: #666;
    }
    h1 {
      font-size: 24px;
      font-weight: 600;
      color: #1a1a1a;
      margin-bottom: 10px;
    }
    h2 {
      font-size: 18px;
      font-weight: 600;
      color: #333;
      margin-top: 30px;
      margin-bottom: 15px;
      padding-bottom: 8px;
      border-bottom: 1px solid #ddd;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin: 20px 0;
      font-size: 12px;
    }
    th, td {
      padding: 10px 8px;
      text-align: left;
      border-bottom: 1px solid #eee;
    }
    th {
      background: #f8f9fa;
      font-weight: 600;
      color: #333;
      text-transform: uppercase;
      font-size: 10px;
      letter-spacing: 0.5px;
    }
    tr:hover { background: #fafafa; }
    .status-active { color: #16a34a; font-weight: 600; }
    .status-draft { color: #6b7280; }
    .status-expired { color: #dc2626; }
    .status-cancelled { color: #dc2626; }
    .readiness-ready { 
      background: #dcfce7; 
      color: #166534; 
      padding: 2px 8px; 
      border-radius: 4px;
      font-size: 11px;
    }
    .readiness-needs_review { 
      background: #fef3c7; 
      color: #92400e; 
      padding: 2px 8px; 
      border-radius: 4px;
      font-size: 11px;
    }
    .readiness-incomplete { 
      background: #fee2e2; 
      color: #991b1b; 
      padding: 2px 8px; 
      border-radius: 4px;
      font-size: 11px;
    }
    .currency { font-family: monospace; }
    .confidence-bar {
      width: 60px;
      height: 8px;
      background: #e5e7eb;
      border-radius: 4px;
      overflow: hidden;
      display: inline-block;
      vertical-align: middle;
    }
    .confidence-fill {
      height: 100%;
      background: #ff6500;
      border-radius: 4px;
    }
    .footer {
      margin-top: 40px;
      padding-top: 20px;
      border-top: 1px solid #ddd;
      font-size: 11px;
      color: #888;
      text-align: center;
    }
    @media print {
      body { padding: 20px; }
      table { font-size: 10px; }
    }
  </style>
</head>
<body>
  <div class="header">
    <div>
      <div class="logo">Cogtics</div>
      <h1>Contracts Report</h1>
    </div>
    <div class="meta">
      <p><strong>Snapshot:</strong> {{snapshotId}}</p>
      <p><strong>Generated:</strong> {{generatedAt}}</p>
      <p><strong>Contracts:</strong> {{contracts.length}}</p>
    </div>
  </div>
  
  <h2>Contract Details</h2>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Status</th>
        <th>ARR</th>
        <th>Readiness</th>
        <th>Confidence</th>
      </tr>
    </thead>
    <tbody>
      {{#each contracts}}
      <tr>
        <td style="font-family: monospace; font-size: 10px;">{{id}}</td>
        <td>{{#if name}}{{name}}{{else}}<em style="color: #999;">Unnamed</em>{{/if}}</td>
        <td class="status-{{status}}">{{status}}</td>
        <td class="currency">{{#if arr}}{{currency}} {{arr}}{{else}}-{{/if}}</td>
        <td>
          {{#if readiness_status}}
          <span class="readiness-{{readiness_status}}">{{readiness_status}}</span>
          {{else}}
          <span style="color: #999;">-</span>
          {{/if}}
        </td>
        <td>
          {{#if confidence_score}}
          <div class="confidence-bar">
            <div class="confidence-fill" style="width: {{confidence_score}}%;"></div>
          </div>
          <span style="font-size: 10px; margin-left: 5px;">{{confidence_score}}%</span>
          {{else}}
          <span style="color: #999;">-</span>
          {{/if}}
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  
  <div class="footer">
    <p>This report was generated by Cogtics. All data is snapshot-scoped and immutable.</p>
    <p>Report ID: {{snapshotId}} | Generated: {{generatedAt}}</p>
  </div>
</body>
</html>
