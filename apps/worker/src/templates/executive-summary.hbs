<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Executive Summary</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      line-height: 1.6;
      color: #1a1a1a;
      background: #fff;
      padding: 40px;
    }
    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      border-bottom: 3px solid #ff6500;
      padding-bottom: 20px;
      margin-bottom: 30px;
    }
    .logo {
      font-size: 28px;
      font-weight: 700;
      color: #ff6500;
    }
    .meta {
      text-align: right;
      font-size: 12px;
      color: #666;
    }
    h1 {
      font-size: 24px;
      font-weight: 600;
      color: #1a1a1a;
      margin-bottom: 10px;
    }
    h2 {
      font-size: 18px;
      font-weight: 600;
      color: #333;
      margin-top: 30px;
      margin-bottom: 15px;
      padding-bottom: 8px;
      border-bottom: 1px solid #ddd;
    }
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 30px;
      margin: 30px 0;
    }
    .metric-card {
      background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
      border-radius: 12px;
      padding: 30px;
      text-align: center;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }
    .metric-value {
      font-size: 42px;
      font-weight: 700;
      color: #ff6500;
      margin-bottom: 5px;
    }
    .metric-label {
      font-size: 14px;
      color: #666;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    .metric-sublabel {
      font-size: 12px;
      color: #999;
      margin-top: 5px;
    }
    .highlight-box {
      background: #fff8f3;
      border-left: 4px solid #ff6500;
      padding: 20px;
      margin: 20px 0;
      border-radius: 0 8px 8px 0;
    }
    .highlight-box h3 {
      font-size: 14px;
      font-weight: 600;
      color: #ff6500;
      margin-bottom: 10px;
    }
    .highlight-box p {
      font-size: 14px;
      color: #666;
    }
    .snapshot-info {
      background: #f8f9fa;
      border-radius: 8px;
      padding: 20px;
      margin-top: 30px;
    }
    .snapshot-info h3 {
      font-size: 14px;
      font-weight: 600;
      color: #333;
      margin-bottom: 15px;
    }
    .snapshot-info dl {
      display: grid;
      grid-template-columns: 150px 1fr;
      gap: 10px;
    }
    .snapshot-info dt {
      font-weight: 600;
      color: #666;
      font-size: 13px;
    }
    .snapshot-info dd {
      color: #333;
      font-size: 13px;
    }
    .footer {
      margin-top: 40px;
      padding-top: 20px;
      border-top: 1px solid #ddd;
      font-size: 11px;
      color: #888;
      text-align: center;
    }
    @media print {
      body { padding: 20px; }
      .metrics-grid { grid-template-columns: repeat(3, 1fr); }
    }
  </style>
</head>
<body>
  <div class="header">
    <div>
      <div class="logo">Cogtics</div>
      <h1>Executive Summary</h1>
    </div>
    <div class="meta">
      <p><strong>Snapshot:</strong> {{snapshotId}}</p>
      <p><strong>Generated:</strong> {{generatedAt}}</p>
    </div>
  </div>
  
  <h2>Key Metrics</h2>
  <div class="metrics-grid">
    <div class="metric-card">
      <div class="metric-value">{{metrics.contractsCount}}</div>
      <div class="metric-label">Active Contracts</div>
    </div>
    <div class="metric-card">
      <div class="metric-value">{{metrics.openIssuesCount}}</div>
      <div class="metric-label">Open Issues</div>
      <div class="metric-sublabel">Requiring attention</div>
    </div>
    <div class="metric-card">
      <div class="metric-value">${{formatNumber metrics.totalArr}}</div>
      <div class="metric-label">Total ARR</div>
      <div class="metric-sublabel">Active contracts</div>
    </div>
  </div>
  
  {{#if metrics.openIssuesCount}}
  <div class="highlight-box">
    <h3>Action Required</h3>
    <p>There are {{metrics.openIssuesCount}} open issues that require review. Please access the Issues dashboard for detailed analysis and resolution steps.</p>
  </div>
  {{/if}}
  
  <div class="snapshot-info">
    <h3>Snapshot Details</h3>
    <dl>
      <dt>Snapshot ID</dt>
      <dd>{{snapshotId}}</dd>
      <dt>Status</dt>
      <dd>{{snapshot.status}}</dd>
      <dt>Started At</dt>
      <dd>{{snapshot.started_at}}</dd>
      <dt>Completed At</dt>
      <dd>{{snapshot.completed_at}}</dd>
    </dl>
  </div>
  
  <div class="footer">
    <p>This report was generated by Cogtics. All data is snapshot-scoped and immutable.</p>
    <p>Report ID: {{snapshotId}} | Generated: {{generatedAt}}</p>
  </div>
</body>
</html>
