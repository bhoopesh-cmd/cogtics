# Copy this file to .env and fill in your values
# cp env.example .env

# Database
DATABASE_URL=postgresql://cogtics:cogtics@localhost:5432/cogtics?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible storage)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=cogtics
S3_REGION=us-east-1

# API Configuration
API_PORT=3000
API_HOST=0.0.0.0
LOG_LEVEL=debug

# Frontend URL (for OAuth redirects - required in development since frontend runs on different port)
# In production, leave empty if frontend is served from same origin as API
FRONTEND_URL=http://localhost:5173

# Worker Configuration
WORKER_CONCURRENCY=5

# Auth (dev mode - header-based)
AUTH_MODE=dev
DEV_USER_ID=user_01
DEV_TENANT_ID=tenant_01

# ============================================
# Clerk Authentication (Production)
# ============================================
# Switch AUTH_MODE to 'clerk' to use Clerk authentication
# Get keys from: https://dashboard.clerk.com → API Keys

# Backend (API server) - Secret Key
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# Frontend (React app) - Publishable Key
# This key is safe to expose in client-side code
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
# Required for security - prevents arbitrary origin reflection
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Node environment
NODE_ENV=development

# ============================================
# Phase 1 - Connector Configuration
# ============================================

# Token encryption (required for credential storage)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_MODE=local

# ============================================
# Stripe Configuration
# ============================================
# For standard Stripe API access (not Stripe Connect), only the secret key is needed.
# Get your secret key from: https://dashboard.stripe.com/apikeys
# Use the Secret Key (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=your sk_test or sk_key here

# For Stripe Connect OAuth (only needed if connecting to other Stripe accounts)
# Get from: https://dashboard.stripe.com/settings/connect
# STRIPE_CLIENT_ID=
# STRIPE_CLIENT_SECRET=

# Stripe CLI Webhook Forwarding (Development Only)
# ============================================
# In development, you cannot create webhook endpoints in Stripe Dashboard that point to localhost.
# Instead, use the Stripe CLI to forward webhooks:
#
# 1. Install Stripe CLI: https://stripe.com/docs/stripe-cli
#    - Windows: scoop install stripe (or download from https://github.com/stripe/stripe-cli/releases)
#    - macOS: brew install stripe/stripe-cli/stripe
#    - Linux: See https://stripe.com/docs/stripe-cli#install
#
# 2. Login to Stripe CLI:
#    stripe login
#
# 3. Forward webhooks to your local server:
#    stripe listen --forward-to localhost:3000/webhooks/stripe
#
# 4. The CLI will output a webhook signing secret that starts with "whsec_..."
#    Copy that value here (NOT your API secret key which starts with sk_):
STRIPE_WEBHOOK_SECRET=

# ============================================
# Salesforce Configuration
SALESFORCE_IS_SANDBOX=false
# ============================================
# Salesforce OAuth (get from Salesforce Connected App)
SALESFORCE_CLIENT_ID=your client id here
SALESFORCE_CLIENT_SECRET=your client secret here
SALESFORCE_REDIRECT_URI=http://localhost:3000/connections/salesforce/callback
FRONTEND_URL=http://localhost:5173
# 32-byte hex (64 hex chars)
TOKEN_ENCRYPTION_KEY=your token encription key here

# ============================================
# LLM Configuration (OpenAI)
# ============================================
# Required for Contract Intelligence features:
# - Structured term extraction from PDFs
# - OCR for scanned documents (uses GPT-4 Vision)
# - Conflict resolution
# - Explanation generation

# Your OpenAI API key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your openai api key here

# Model selection (optional, defaults to gpt-4o-mini)
# For text extraction: gpt-4o-mini (fast, cheap)
# For complex analysis: gpt-4o (more accurate)
OPENAI_MODEL=gpt-4o-mini