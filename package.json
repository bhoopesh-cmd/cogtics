{
  "name": "cogtics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run docker:up && concurrently -n api,web -c green,blue \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:api": "pnpm run --filter @cogtics/api dev",
    "dev:web": "pnpm run --filter @cogtics/web dev",
    "dev:worker": "pnpm run --filter @cogtics/worker dev",
    "build": "pnpm run build:web && pnpm run build:api && pnpm run build:worker",
    "build:web": "pnpm run --filter @cogtics/web build",
    "build:api": "pnpm run --filter @cogtics/api build",
    "docker:up": "docker-compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f docker/docker-compose.yml logs -f",
    "db:migrate": "pnpm run --filter @cogtics/db migrate",
    "db:seed": "pnpm run --filter @cogtics/db seed",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "typecheck": "pnpm run -r typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"apps/api/tests/**\"",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate": "tsx tools/validation/run-validation.ts",
    "validate:detection": "tsx tools/validation/detection-validator.ts",
    "validate:tenants": "tsx tools/validation/tenant-isolation-test.ts",
    "validate:resilience": "tsx tools/validation/resilience-test.ts",
    "validate:security": "tsx tools/validation/security-test.ts",
    "validate:all": "pnpm validate && pnpm validate:detection && pnpm validate:tenants && pnpm validate:resilience && pnpm validate:security",
    "build:worker": "pnpm run --filter @cogtics/worker build"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^4.0.16",
    "concurrently": "^8.2.2",
    "dotenv": "^17.2.3",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
