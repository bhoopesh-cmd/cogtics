{
  "name": "@cogtics/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "migrate": "dotenv -e ../../.env -- dbmate -d ./migrations --no-dump-schema up",
    "migrate:down": "dotenv -e ../../.env -- dbmate -d ./migrations --no-dump-schema down",
    "migrate:new": "dotenv -e ../../.env -- dbmate -d ./migrations new",
    "migrate:status": "dotenv -e ../../.env -- dbmate -d ./migrations status",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@cogtics/schemas": "workspace:*",
    "kysely": "^0.27.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/pg": "^8.10.9",
    "csv-parse": "^6.1.0",
    "dbmate": "^2.10.0",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2"
  }
}
