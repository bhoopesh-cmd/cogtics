{
  "name": "@cogtics/stress-test",
  "version": "1.0.0",
  "description": "Stress testing tools for Cogtics platform",
  "private": true,
  "type": "module",
  "scripts": {
    "verify": "tsx scripts/verify-setup.ts",
    "volume": "tsx scripts/volume-test.ts",
    "monitor": "tsx scripts/monitor.ts",
    "report": "tsx scripts/report.ts",
    "test:small": "tsx scripts/volume-test.ts --batch=50 --concurrency=5",
    "test:medium": "tsx scripts/volume-test.ts --batch=100 --concurrency=10",
    "test:large": "tsx scripts/volume-test.ts --batch=500 --concurrency=25",
    "test:xlarge": "tsx scripts/volume-test.ts --batch=1000 --concurrency=50",
    "test:stress": "tsx scripts/volume-test.ts --batch=2400 --concurrency=100",
    "test:all": "npm run test:small && npm run test:medium && npm run test:large && npm run test:xlarge && npm run report",
    "concurrent": "tsx scripts/concurrency-test.ts",
    "concurrent:light": "tsx scripts/concurrency-test.ts --scenario=light",
    "concurrent:medium": "tsx scripts/concurrency-test.ts --scenario=medium",
    "concurrent:heavy": "tsx scripts/concurrency-test.ts --scenario=heavy",
    "concurrent:stress": "tsx scripts/concurrency-test.ts --scenario=stress",
    "concurrent:extreme": "tsx scripts/concurrency-test.ts --scenario=extreme",
    "tenant:test": "tsx scripts/multi-tenant-test.ts --scenario=multi_tenant_basic",
    "tenant:extended": "tsx scripts/multi-tenant-test.ts --scenario=multi_tenant_extended",
    "mixed:test": "tsx scripts/mixed-workload-test.ts --duration=300",
    "pool:stress": "tsx scripts/pool-stress-test.ts --connections=100",
    "phase2:all": "npm run concurrent:light && npm run concurrent:medium && npm run concurrent:heavy && npm run report"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "p-limit": "^5.0.0",
    "jose": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
